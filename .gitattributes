# Batch launchers must keep CRLF line endings in every checkout (cmd.exe).
*.cmd text eol=crlf

# Shipped skill files ship as canonical LF bytes: the npm tarball carries
# them as LF and the launcher provisions them verbatim, so Windows checkouts
# (core.autocrlf=true by default) must not rewrite them to CRLF. The pre-#151
# migration digest anchor itself is protected by the immutable historical
# fixtures pinned below, not by these shipped bytes.
skills/**/*.md text eol=lf

# Immutable pre-#151 skill-migration fixtures are byte-identity-anchored by
# SHA-256 (tests/shipped-skills.test.ts): they hold the true historical bytes
# the launcher migration compares installed copies against. Pin LF so Windows
# checkouts cannot alter the anchored bytes (same rationale as the skills pin
# above).
tests/fixtures/skill-migration/**/*.md text eol=lf
