{
  "enabled": true,
  "reviewerTimeoutMs": 600000,
  "executorTimeoutMs": 1800000,
  "maxCorrectionCycles": 3,
  "implementationGuidanceAfterCorrectionAttempts": 1,
  "retainBundles": "on-failure",
  "review": {
    "activeReviewers": [
      {
        "source": "external",
        "id": "codex-sol"
      }
    ]
  },
  "execution": {
    "workerResources": {
      "local-primary": {
        "selection": {
          "source": "pi",
          "model": "openai-codex/gpt-5.6-sol"
        },
        "maxConcurrent": 1
      },
      "codex-cloud-overflow": {
        "selection": {
          "source": "external",
          "id": "codex-luna"
        },
        "maxConcurrent": 3
      },
      "claude-overflow": {
        "selection": {
          "source": "external",
          "id": "claude"
        },
        "maxConcurrent": 4
      }
    },
    "routes": {
      "execute": [
        { "resourceId": "local-primary", "thinkingLevel": "high" },
        { "resourceId": "codex-cloud-overflow" },
        { "resourceId": "claude-overflow" }
      ],
      "research": [
        { "resourceId": "codex-cloud-overflow" },
        { "resourceId": "local-primary", "thinkingLevel": "medium" }
      ]
    },
    "maxWorkers": 4,
    "subtaskNotifications": "quiet",
    "retryPolicy": {
      "maxRetries": 2,
      "baseDelayMs": 1000,
      "maxDelayMs": 15000,
      "jitter": true,
      "maxSameIncidentRepeats": 2
    }
  },
  "externalAgents": {
    "codex-luna": {
      "adapter": "codex-cli",
      "command": "codex",
      "review": {
        "model": "gpt-5.6-luna",
        "args": ["-c", "model_reasoning_effort=\"max\""],
        "timeoutMs": 600000
      },
      "execution": {
        "model": "gpt-5.6-luna",
        "args": ["-c", "model_reasoning_effort=\"max\""],
        "timeoutMs": 1800000
      }
    },
    "codex-sol": {
      "adapter": "codex-cli",
      "command": "codex",
      "review": {
        "model": "gpt-5.6-sol",
        "args": ["-c", "model_reasoning_effort=\"high\""],
        "timeoutMs": 600000
      },
      "execution": {
        "model": "gpt-5.6-sol",
        "args": ["-c", "model_reasoning_effort=\"high\""],
        "timeoutMs": 1800000
      }
    },
    "claude": {
      "adapter": "claude-cli",
      "command": "claude",
      "review": { "timeoutMs": 600000 },
      "execution": { "timeoutMs": 1800000 }
    },
    "my-binary-agent": {
      "adapter": "run-as-binary",
      "command": "/absolute/path/to/my-agent",
      "execution": {
        "protocol": "pi-review-executor-jsonl-v1",
        "args": [],
        "timeoutMs": 1800000
      }
    }
  }
}
