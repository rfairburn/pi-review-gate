{
  "enabled": true,
  "maxCorrectionCycles": 30,
  "implementationGuidanceAfterCorrectionAttempts": 1,
  "maxPatchBytes": 200000,
  "maxFileBytes": 1048576,
  "maxSnapshotBytes": 52428800,
  "retainBundles": "on-failure",
  "externalAgents": [
    {
      "id": "codex",
      "adapter": "codex-cli",
      "review": {
        "timeoutMs": 600000
      }
    },
    {
      "id": "claude",
      "adapter": "claude-cli",
      "review": {
        "timeoutMs": 600000
      }
    }
  ],
  "review": {
    "activeReviewers": [
      { "source": "external", "id": "codex" },
      { "source": "pi", "model": "ollama/glm-5.2" },
      { "source": "external", "id": "claude" }
    ]
  }
}
