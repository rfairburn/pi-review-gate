{
  "name": "pi-review-gate",
  "version": "0.1.0",
  "description": "External pi extension for post-turn code review gates.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean:test": "node -e \"require('node:fs').rmSync('dist-test', { recursive: true, force: true })\"",
    "build:test": "npm run clean:test && tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && npm run test:run",
    "test:run": "node --test --test-concurrency=4 dist-test/tests/*.test.js",
    "test:serial": "npm run build && npm run build:test && npm run test:run:serial",
    "test:run:serial": "node --test --test-concurrency=1 dist-test/tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
